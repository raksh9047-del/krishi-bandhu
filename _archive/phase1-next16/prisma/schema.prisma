// Krishi-Bandhu — Maharashtra Agritech Platform
// Prisma schema: database models only. Application logic lives in src/
//
// DPDP 2023 Compliance Notes:
// - ConsentLog captures granular, purpose-bound consent per farmer (DPDP §8)
// - Farmer.consentGiven / consentTimestamp tracks opt-in state
// - All PII fields (phone, mhfrId) isolated for data minimization
// - consentArtifactId links to the DPDP consent manifest
//
// Maharashtra-Specific Fields:
// - mhfrId: Maharashtra Farmer Registry ID (state govt database)
// - soilType: Regur (Black Cotton), Alluvial (Godavari/Krishna basins), Laterite (Konkan)
// - Mandi names reflect APMC yards (Lasalgaon, Vashi, etc.)
// - Marathi messaging in PriceAlert for rural accessibility
// - Procurement agencies: NAFED, CCI, MARKFED (Maharashtra state schemes)
//
// Note: Prisma 7 — the SQLite connection URL lives in prisma7.config.ts,
// not in this file. Application builds in the project root /src directory.

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// =============================================================================
// 1. USER — AUTH & ROLES
// =============================================================================

model User {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  role           String // "FARMER", "BUYER", "FPO_AGENT", "KRISHI_SAHAYAK", "GOVT_SDO"
  createdAt      DateTime @default(now())

  farmer         Farmer?

  // Farmers managed by this FPO agent / Krishi Sahayak
  managedFarmers ManagedFarmer[]

  @@map("users")
}

// Join table: FPO agent / Krishi Sahayak → farmers they manage
model ManagedFarmer {
  id       String @id @default(uuid())
  agentId  String
  farmerId String

  agent    User   @relation(fields: [agentId], references: [id])
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  @@unique([agentId, farmerId])
  @@map("managed_farmers")
}

// =============================================================================
// 2. FARMER — PROFILE & DPDP CONSENT
// =============================================================================

model Farmer {
  id               String   @id @default(uuid())
  userId           String   @unique
  mhfrId           String? // Maharashtra Farmer Registry ID — state govt database
  village          String
  district         String
  taluka           String
  landAreaAcres    Float
  soilType         String // "Black Regur", "Alluvial", "Laterite"
  isTenantFarmer   Boolean  @default(false)
  landOwnerId      String? // links tenant to the land-owning Farmer
  fpoId            String? // Farmer Producer Organisation membership
  consentGiven     Boolean  @default(false) // DPDP §8 opt-in
  consentTimestamp DateTime?

  user             User          @relation(fields: [userId], references: [id])
  cropListings     CropListing[]
  consentLogs      ConsentLog[]
  inputVouchers    InputVoucher[]
  disputesRaised   Dispute[]     @relation("DisputeFarmer")
  priceAlerts      PriceAlert[]

  @@map("farmers")
}

// =============================================================================
// 3. CROP LISTING — ONDC-READY PRODUCE SALE
// =============================================================================

model CropListing {
  id                     String   @id @default(uuid())
  farmerId               String
  crop                   String // "Soybean", "Cotton", "Onion", "Sugarcane"
  variety                String?
  quantityQuintal        Float
  moistureEstimate       Float?
  gradingPhotos          String[] // URLs to cloud-stored photos
  preDispatchHash        String // SHA-256 hash of pre-dispatch quality data
  gpsLatitude            Float?
  gpsLongitude           Float?
  targetMandi            String
  grossPrice             Float
  transportCost          Float
  mandiCess              Float // APMC levy
  commissionFee          Float // commission agent / arhatiya fee
  moistureDeduction      Float
  netRealization         Float
  isSharedTransport      Boolean @default(false)
  advanceTakenFromTrader Boolean @default(false)
  fpoBacked              Boolean @default(false)
  status                 String // "LISTED", "BID_RECEIVED", "SOLD", "DISPUTED"
  createdAt              DateTime @default(now())
  ondListingId           String? // ONDC buyer-seller reference

  farmer               Farmer        @relation(fields: [farmerId], references: [id])
  transactions         Transaction[]
  gradingPhotos        GradingPhoto[]

  @@map("crop_listings")
}

// Photo URLs attached to a listing (grading evidence)
model GradingPhoto {
  id          String      @id @default(uuid())
  listingId   String
  url         String
  sortOrder   Int         @default(0)

  listing     CropListing @relation(fields: [listingId], references: [id])

  @@map("grading_photos")
}

// =============================================================================
// 4. TRANSACTION — HASH-CHAINED LEDGER
// =============================================================================

model Transaction {
  id                String   @id @default(uuid())
  listingId         String
  buyerId           String
  buyerType         String // "MANDI", "KIRANA", "FPO", "PROCESSOR"
  buyerName         String
  finalPrice        Float
  quantitySold      Float
  ledgerHash        String // SHA-256 chained hash for immutability
  previousBlockHash String?
  paymentStatus     String // "PENDING", "PAID", "OVERDUE"
  paymentDueDate    DateTime
  paymentReceivedAt DateTime?
  createdAt         DateTime @default(now())
  settlementId      String? // UPI / bank settlement reference

  listing           CropListing @relation(fields: [listingId], references: [id])
  dispute           Dispute?

  @@map("transactions")
}

// =============================================================================
// 5. CONSENT LOG — DPDP §8 COMPLIANCE
// =============================================================================

model ConsentLog {
  id                String   @id @default(uuid())
  farmerId          String
  dataType          String // "LOCATION", "CROP_DATA", "TRANSACTION", "MHFR_ID"
  purpose           String // "ONDC_LISTING", "BUYER_MATCHING", "GOVT_SCHEME"
  isGranted         Boolean  @default(true) // DPDP §8(2) — revocable consent
  grantedAt         DateTime @default(now())
  revokedAt         DateTime?
  consentArtifactId String // links to DPDP consent artifact/manifest

  farmer            Farmer   @relation(fields: [farmerId], references: [id])

  @@map("consent_logs")
}

// =============================================================================
// 6. DISPUTE — SDO RESOLUTION WORKFLOW
// =============================================================================

model Dispute {
  id               String   @id @default(uuid())
  transactionId    String   @unique
  farmerId         String
  reason           String // "MOISTURE_MISMATCH", "WEIGHT_DISCREPANCY", "GRADE_DISCREPANCY", "PAYMENT_DELAY"
  preDispatchHash  String // original hash for verification
  farmerClaimGrade String
  mandiClaimGrade  String
  status           String // "RAISED", "UNDER_SDO_REVIEW", "RESOLVED_FARMER", "RESOLVED_MANDI", "ESCALATED"
  sdoNotes         String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())

  transaction      Transaction @relation(fields: [transactionId], references: [id])
  farmer           Farmer      @relation("DisputeFarmer", fields: [farmerId], references: [id])

  @@map("disputes")
}

// =============================================================================
// 7. INPUT VOUCHER — SUBSIDY / FERTILIZER SYSTEM
// =============================================================================

model InputVoucher {
  id                String   @id @default(uuid())
  farmerId          String
  fpoId             String
  fpoName           String
  crop              String
  estimatedYieldQtl Float
  amount            Int // in paise — integer for precise monetary math
  voucherCode       String   @unique
  partnerStoreId    String
  partnerStoreName  String
  isRedeemed        Boolean  @default(false)
  redeemedAt        DateTime?
  expiryDate        DateTime
  createdAt         DateTime @default(now())

  farmer            Farmer   @relation(fields: [farmerId], references: [id])

  @@map("input_vouchers")
}

// =============================================================================
// 8. MANDI — APMC REGISTRY
// =============================================================================

model Mandi {
  id                    String   @id @default(uuid())
  name                  String // "Lasalgaon APMC", "Vashi APMC", etc.
  district              String
  state                 String  @default("Maharashtra")
  latitude              Float
  longitude             Float
  crops                 String[] // crops traded at this mandi
  todayArrivalsTonnes   Float?
  anomalyFlag           Boolean @default(false) // detects unusual price/volume
  complianceTheaterFlag Boolean @default(false) // flagged for suspicious bid patterns

  mandiPrices           MandiPrice[]

  @@map("mandis")
}

// =============================================================================
// 9. MANDI PRICE — PRICE DISCOVERY
// =============================================================================

model MandiPrice {
  id             String   @id @default(uuid())
  mandiId        String
  crop           String
  modalPrice     Float // per quintal — modal transaction price
  minPrice       Float
  maxPrice       Float
  arrivalsTonnes Float
  numberOfBids   Int // low bid count → compliance theater detection
  timestamp      DateTime
  source         String // "eNAM", "AGMARKNET", "MANUAL"

  mandi          Mandi    @relation(fields: [mandiId], references: [id])

  @@map("mandi_prices")
}

// =============================================================================
// 10. WAREHOUSE — WDRA ACCREDITED STORAGE
// =============================================================================

model Warehouse {
  id                      String   @id @default(uuid())
  name                    String
  wdraAccredited          Boolean @default(true) // WDRA = Warehousing Dev & Regulatory Authority
  district                String
  latitude                Float
  longitude               Float
  storageCapacityTonnes   Float
  currentOccupancyPercent Float
  pledgeLoanRatePercent   Float // e.g., 7.5 — loan against stored produce
  supportedCrops          String[]

  @@map("warehouses")
}

// =============================================================================
// 11. PRICE ALERT — RURAL ACCESSIBILITY (MARATHI)
// =============================================================================

model PriceAlert {
  id                String   @id @default(uuid())
  farmerId          String
  district          String
  crop              String
  alertType         String // "PRICE_DROP", "WEATHER_RISK", "POLICY_CHANGE", "OVERSUPPLY"
  severity          String // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  messageMarathi    String // Marathi message for rural farmers
  messageEnglish    String
  recommendedAction String
  createdAt         DateTime @default(now())
  isRead            Boolean  @default(false)

  farmer            Farmer   @relation(fields: [farmerId], references: [id])

  @@map("price_alerts")
}

// =============================================================================
// 12. PROCUREMENT SLOT — GOVERNMENT PROCUREMENT
// =============================================================================

model ProcurementSlot {
  id                   String   @id @default(uuid())
  centerName           String // "NAFED Karanja Center", "CCI Nashik"
  agency               String // "NAFED", "CCI", "MARKFED"
  crop                 String
  totalQuotaQuintal    Float
  remainingQuotaQuintal Float
  date                 DateTime
  bookedSlots          Int      @default(0)
  maxSlotsPerDay       Int

  @@map("procurement_slots")
}